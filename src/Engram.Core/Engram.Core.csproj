<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema doc is compiled in rather than copied into source, so
         docs/engram-schema.sql remains the single authority for database shape and
         cannot drift from what the binary actually applies. -->
    <EmbeddedResource Include="../../docs/engram-schema.sql" LogicalName="Engram.Core.Schema.sql" />
  </ItemGroup>

</Project>
