<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below raise a transitive dependency without any project
         taking a direct reference to a package its code never names. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="ModelContextProtocol" Version="2.0.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Pulls SQLitePCLRaw.bundle_e_sqlite3 transitively, which is the statically linked
         SQLite D1 specifies. No separate reference needed. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 resolves the bundle at 2.1.11, whose native SQLite is
         GHSA-2m69-gcr7-jv3q (high, affects <= 2.1.11). Warnings are errors, so this is a
         build break rather than an advisory. Pinned forward to the first clean release. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Roslyn, for the tier-2 sidecar only — engram-roslyn.csproj is the sole referent,
         and D1 keeps it out of every other project. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!-- The managed binding and the native llama.cpp build it loads. Their versions move
         together: the binding P/Invokes an unversioned C API, so a backend from a different
         release is an undefined-symbol crash at first load rather than a restore failure. -->
    <PackageVersion Include="LLamaSharp" Version="0.27.0" />
    <PackageVersion Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <!-- Only referenced under -p:EngramGpu=cuda12; pinned here so the version cannot drift from
         the binding's when someone does. -->
    <PackageVersion Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
  </ItemGroup>

</Project>
