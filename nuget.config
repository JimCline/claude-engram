<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Central package management plus more than one feed is NU1507, and warnings are errors
       here, so a machine that happens to carry a second source (a corporate mirror, a
       GitHub Packages feed) fails the build before it compiles a line. Restore inherited
       whatever the machine had until this file existed; <clear /> drops that inheritance so
       every machine restores from the same place. Every package in Directory.Packages.props
       is public nuget.org, so there is nothing here a private feed would supply. Adding a
       second source means adding <packageSourceMapping> with it. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
